// AdMob identifiers for Colorvia.
//
// Debug builds always request Google's official test banner unit ID in code
// (see AdMobConfiguration). GADApplicationIdentifier still uses ADMOB_APP_ID
// so the Mobile Ads SDK can start.
//
// ~  → AdMob App ID (Info.plist GADApplicationIdentifier)
// /  → Banner ad unit ID (Release only)

ADMOB_APP_ID = ca-app-pub-8687520805381056~7543227876
ADMOB_BANNER_AD_UNIT_ID = ca-app-pub-8687520805381056/8545318350
