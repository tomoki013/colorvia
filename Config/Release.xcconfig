// Production external-service values.
// The Release build phase fails when ads are enabled without both AdMob identifiers.
ADS_ENABLED = YES
CLOUD_SYNC_ENABLED = NO
// AdMob identifiers for Colorvia (Tomokichi App Studio).
// ~  → AdMob App ID (Info.plist GADApplicationIdentifier)
// /  → Banner ad unit ID
ADMOB_APP_ID = ca-app-pub-8687520805381056~7543227876
ADMOB_BANNER_AD_UNIT_ID = ca-app-pub-8687520805381056/8545318350
ICLOUD_CONTAINER_ID =
// The shared support client key. It ships inside the binary, so it is a filter
// the API uses to ignore anything merely claiming source: "colorvia-ios" — not
// a credential, and not what keeps the endpoint safe. The same value is set on
// the API as SUPPORT_CLIENT_KEY; roll it out here first, since unset there
// means unenforced.
SUPPORT_CLIENT_KEY = cec87aa57c013f3749a1bb1a09cbfa3e5e33048c8dd195d0
