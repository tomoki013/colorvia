    "faq.account.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No. Colorvia works without creating an account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいえ。Colorviaはアカウントを作成せずに利用できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No. Colorvia funciona sin crear una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non. Colorvia fonctionne sans créer de compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein. Colorvia funktioniert ohne Konto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No. Colorvia funziona senza creare un account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não. O Colorvia funciona sem criar uma conta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니요. 계정을 만들지 않고 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要。Colorvia无需创建账户即可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要。Colorvia 無須建立帳號即可使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет. Colorvia работает без учётной записи."
          }
        }
      }
    },
