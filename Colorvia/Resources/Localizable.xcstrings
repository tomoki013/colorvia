    "terms.disclaimer.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map boundaries and country classifications are provided for visualization and do not express a political position."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図の境界線と国・地域の分類は表示目的であり、政治的立場を示すものではありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites y clasificaciones se muestran con fines visuales y no expresan una postura política."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frontières et classifications sont affichées à titre visuel et n’expriment aucune position politique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzen und Klassifizierungen dienen der Darstellung und stellen keine politische Position dar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confini e classificazioni sono visuali e non esprimono posizioni politiche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fronteiras e classificações são apenas visuais e não expressam posição política."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 경계와 국가 분류는 시각화를 위한 것이며 정치적 입장을 나타내지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图边界和国家分类仅用于可视化，不代表任何政治立场。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖邊界和國家分類僅供視覺呈現，不代表任何政治立場。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Границы и классификации показаны для визуализации и не выражают политическую позицию."
          }
        }
      }
    },
