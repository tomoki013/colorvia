    "guide.add.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the plus button, search for a country, and mark it as visited."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ボタンを押し、国を検索して訪問済みにします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
