    "terms.use.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze die App rechtmäßig und störe weder Betrieb noch Verteilung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records stay on device without iCloud auto-sync. You may migrate via JSON and manage those files yourself. The operator cannot restore data lost to uninstall or device failure. Use the app lawfully."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la app legalmente y no interfieras con su funcionamiento o distribución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l’app légalement et ne perturbez pas son fonctionnement ou sa distribution."
          }
        },
        "it" : {
