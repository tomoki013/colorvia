    "guide.add.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf Plus, suche ein Land und markiere es als besucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + on Home, search or browse by region, check countries you visited, then confirm. You cannot add countries by tapping the world map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón más, busca un país y márcalo como visitado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton plus, recherchez un pays et marquez-le comme visité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante più, cerca un paese e segnalo come visitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム右下の＋を押し、国名検索または地域別一覧から訪れた国にチェックを付けて確定します。世界地図をタップして国を追加することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "＋ 버튼을 누르고 국가를 검색해 방문한 국가로 표시하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no botão de mais, procure um país e marque como visitado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите плюс, найдите страну и отметьте её как посещённую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击加号按钮，搜索国家并标记为已访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下加號按鈕，搜尋國家並標記為已造訪。"
          }
        }
      }
    },
