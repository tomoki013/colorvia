            "value": "Отправить сообщение"
          }
        }
      }
    },
    "contact.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send us a bug report, a question, or feedback. We read every message and usually reply within three business days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不具合、ご質問、ご意見をお送りください。内容を確認のうえ、通常3営業日以内を目安にご返信します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíanos un error, una pregunta o un comentario. Leemos todos los mensajes y solemos responder en un plazo de tres días hábiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez-nous un bug, une question ou un commentaire. Nous lisons chaque message et répondons généralement sous trois jours ouvrés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie uns einen Fehlerbericht, eine Frage oder Feedback. Wir lesen jede Nachricht und antworten in der Regel innerhalb von drei Werktagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviaci una segnalazione, una domanda o un commento. Leggiamo ogni messaggio e di solito rispondiamo entro tre giorni lavorativi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um erro, uma dúvida ou um comentário. Lemos todas as mensagens e normalmente respondemos em até três dias úteis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류, 질문, 의견을 보내주세요. 모든 메시지를 확인하며 보통 3영업일 이내에 답변드립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎反馈问题、提出疑问或分享意见。我们会查看每条消息，通常在三个工作日内回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎回報問題、提出疑問或分享意見。我們會查看每則訊息，通常在三個工作日內回覆。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите об ошибке, задайте вопрос или поделитесь мнением. Мы читаем каждое сообщение и обычно отвечаем в течение трёх рабочих дней."
          }
        }
      }
    },
