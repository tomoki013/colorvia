    "updates.v1_0_0.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first version of Colorvia. Colour a world map by the countries you’ve visited, and go beyond countries in 11 supported ones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorviaの最初のバージョンです。訪れた国を選んで世界地図を彩り、対応11か国では国の内側まで記録できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera versión de Colorvia. Colorea el mapamundi con los países que has visitado y, en 11 de ellos, también sus regiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première version de Colorvia. Coloriez la carte du monde selon les pays visités, et allez plus loin dans 11 pays."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Version von Colorvia. Färben Sie die Weltkarte nach besuchten Ländern – in 11 Ländern auch innerhalb des Landes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima versione di Colorvia. Colora il planisfero con i paesi visitati e, in 11 di essi, anche le regioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira versão do Colorvia. Pinte o mapa-múndi com os países visitados e, em 11 deles, também as regiões."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia의 첫 번째 버전입니다. 방문한 나라로 세계 지도를 칠하고, 지원되는 11개국에서는 국내 지역까지 기록할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia 的首个版本。选择去过的国家为世界地图上色，在 11 个国家还可记录国内地区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia 的首個版本。選擇去過的國家為世界地圖上色，在 11 個國家還可記錄國內地區。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая версия Colorvia. Раскрашивайте карту мира по посещённым странам, а в 11 странах — и регионы внутри них."
          }
        }
      }
    },
