    "updates.version.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Initial preview with the interactive world map, country selection, statistics, themes, and multilingual support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インタラクティブな世界地図、国選択、統計、テーマ、多言語対応を含む初期プレビューです。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa inicial con mapa interactivo, selección de países, estadísticas, temas e idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu initial avec carte interactive, sélection des pays, statistiques, thèmes et langues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Vorschau mit interaktiver Weltkarte, Länderauswahl, Statistik, Designs und Sprachen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima iniziale con mappa interattiva, selezione paesi, statistiche, temi e lingue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia inicial com mapa interativo, seleção de países, estatísticas, temas e idiomas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화형 세계 지도, 국가 선택, 통계, 테마와 다국어를 포함한 초기 미리보기입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始预览包含交互式世界地图、国家选择、统计、主题和多语言支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "初始預覽包含互動式世界地圖、國家選擇、統計、主題和多語言支援。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая версия с интерактивной картой, выбором стран, статистикой, темами и языками."
          }
        }
      }
    },
