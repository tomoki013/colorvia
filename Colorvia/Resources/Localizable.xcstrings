    "privacy.analytics.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia enthält keine eigenen Verhaltensanalyse-SDKs. Anzeigenleistung kann von Google AdMob gemessen werden, wie unter Werbung beschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia does not include a separate analytics SDK. World and regional map data is bundled (e.g. Natural Earth). Online MapKit tiles are not used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia no incluye SDK de análisis de comportamiento propios. El rendimiento de los anuncios puede medirlo Google AdMob, como se describe en Publicidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia n’inclut pas de SDK d’analyse comportementale distinct. Les performances publicitaires peuvent être mesurées par Google AdMob, comme décrit dans Publicité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia non include SDK di analisi comportamentale separati. Le prestazioni degli annunci possono essere misurate da Google AdMob, come descritto in Pubblicità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorviaは独自の行動分析SDKを含みません。世界地図と国内地域データはNatural Earth等を基にアプリ内へ同梱しており、MapKitのオンライン地図タイルは使用しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia는 별도의 행동 분석 SDK를 포함하지 않습니다. 광고 성과는 ‘광고’에 설명된 대로 Google AdMob이 측정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Colorvia não inclui SDKs próprios de análise comportamental. O desempenho dos anúncios pode ser medido pelo Google AdMob, conforme descrito em Publicidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia не включает отдельные SDK поведенческой аналитики. Эффективность рекламы может измерять Google AdMob, как описано в разделе «Реклама»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia 不包含单独的行为分析 SDK。广告效果可能由 Google AdMob 按“广告”一节所述进行衡量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia 不包含獨立的行為分析 SDK。廣告成效可能由 Google AdMob 依「廣告」一節所述進行衡量。"
          }
        }
      }
    },
