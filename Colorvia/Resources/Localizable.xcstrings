    "contact.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To reply and investigate issues, we send what you enter here along with your app version, OS, and locale. Your visit records are never sent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お問い合わせへの回答と不具合の調査のため、入力内容と、アプリのバージョンやOSなど利用環境に関する情報を送信します。訪問記録は送信しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder e investigar incidencias, enviamos lo que escribas junto con la versión de la app, el sistema operativo y el idioma. Tus registros de viaje nunca se envían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour répondre et enquêter, nous envoyons ce que vous saisissez ainsi que la version de l’app, le système et la langue. Vos données de voyage ne sont jamais envoyées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um zu antworten und Fehler zu untersuchen, senden wir Ihre Eingaben zusammen mit App-Version, Betriebssystem und Sprache. Ihre Reisedaten werden nie gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rispondere e analizzare i problemi inviamo quanto scrivi insieme a versione dell’app, sistema operativo e lingua. I tuoi dati di viaggio non vengono mai inviati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder e investigar problemas, enviamos o que você escreve junto com a versão do app, o sistema e o idioma. Seus registros de viagem nunca são enviados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변과 문제 확인을 위해 입력하신 내용과 앱 버전, OS, 언어 정보를 전송합니다. 방문 기록은 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了回复并排查问题，我们会发送您填写的内容以及应用版本、系统和语言信息。您的访问记录不会被发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了回覆並排查問題，我們會傳送您填寫的內容以及應用程式版本、系統和語言資訊。您的造訪紀錄不會被傳送。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы ответить и разобраться в проблеме, мы отправляем введённые данные вместе с версией приложения, ОС и языком. Ваши записи о поездках не отправляются."
          }
        }
      }
    },
