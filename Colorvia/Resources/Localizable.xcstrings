    "contact.reply_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can send this without turning it on. We only ask for an email address if you want a reply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのままでも送信できます。返信をご希望の場合のみ、メールアドレスをお伺いします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes enviarlo sin activarlo. Solo pedimos un correo electrónico si quieres respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez envoyer sans l’activer. Nous ne demandons une adresse e-mail que si vous souhaitez une réponse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können auch ohne diese Option senden. Wir fragen nur nach einer E-Mail-Adresse, wenn Sie eine Antwort möchten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi inviare anche senza attivarlo. Chiediamo un indirizzo e-mail solo se desideri una risposta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode enviar sem ativar. Só pedimos um e-mail se você quiser resposta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜지 않아도 보낼 수 있습니다. 답변을 원하실 때만 이메일 주소를 여쭤봅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不开启也可以发送。仅在您希望收到回复时才需要填写电子邮件地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不開啟也可以傳送。僅在您希望收到回覆時才需要填寫電子郵件地址。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно отправить и без этого. Адрес эл. почты нужен, только если вы ждёте ответ."
          }
        }
      }
    },
