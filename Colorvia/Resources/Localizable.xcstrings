    "privacy.collection.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia benötigt weder Konto, Standort, Fotos noch Zugriff auf Kontakte. Wenn Sie eine Anfrage senden, werden Antwort-E-Mail, Nachricht, App- und Build-Version, OS-Version, Sprache, Sendezeit und eine zufällige Support-ID für Support und Missbrauchsprävention übermittelt. Ihre Besuchsdaten werden nie angehängt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia does not require an account. Visit records stay on your device. Only if you send support do we receive category, name, email, message, app/build/OS info, locale, time, enquiry id and a random client id for support and abuse prevention. Visit records are never attached."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia no requiere cuenta, ubicación, fotos ni acceso a contactos. Si envías una consulta, se transmiten el correo de respuesta, el mensaje, las versiones de la app y compilación, la versión del SO, el idioma, la fecha de envío y un identificador de soporte aleatorio para brindar soporte y evitar abusos. Tus registros de visitas nunca se adjuntan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia ne demande ni compte, ni localisation, ni photos, ni accès aux contacts. Si vous envoyez une demande, l’e-mail de réponse, le message, les versions de l’app et du build, la version de l’OS, la langue, la date d’envoi et un identifiant d’assistance aléatoire sont transmis pour l’assistance et la prévention des abus. Vos visites ne sont jamais jointes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia non richiede account, posizione, foto o accesso ai contatti. Se invii una richiesta, email di risposta, messaggio, versioni di app e build, versione del sistema operativo, lingua, data di invio e un identificatore di supporto casuale vengono trasmessi per assistenza e prevenzione degli abusi. I tuoi dati di visita non vengono mai allegati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorviaはアカウント登録を必要としません。訪問国・国内地域の記録は端末内に保存されます。お問い合わせを送信した場合に限り、カテゴリ、名前、メールアドレス、本文、アプリ／ビルド／OS情報、ロケール、送信日時、問い合わせID、ランダムなクライアントIDなどをサポート対応と不正防止のために送信します。訪問記録は添付されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia는 계정, 위치, 사진 또는 연락처 접근을 요구하지 않습니다. 문의를 보내는 경우에만 답변 이메일, 내용, 앱 및 빌드 버전, OS 버전, 언어, 전송 시각과 임의의 지원 식별자를 지원 및 악용 방지를 위해 전송합니다. 방문 기록은 첨부되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Colorvia não exige conta, localização, fotos nem acesso aos contatos. Se você enviar uma solicitação, o e-mail de resposta, a mensagem, as versões do app e da compilação, a versão do sistema, o idioma, a data de envio e um identificador aleatório de suporte serão enviados para atendimento e prevenção de abuso. Seus registros de visitas nunca são anexados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia не требует аккаунта, геолокации, фотографий или доступа к контактам. При отправке запроса адрес для ответа, сообщение, версии приложения и сборки, версия ОС, язык, время отправки и случайный идентификатор поддержки передаются для поддержки и предотвращения злоупотреблений. Данные о посещениях никогда не прикладываются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia 不要求账户、位置、照片或通讯录访问权限。仅在你发送咨询时，回复电子邮件、消息、应用和构建版本、操作系统版本、语言、发送时间及随机支持标识符会用于支持和防止滥用。你的访问记录绝不会附加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia 不要求帳號、位置、照片或聯絡人存取權。只有在你傳送詢問時，回覆電子郵件、訊息、App 和組建版本、作業系統版本、語言、傳送時間及隨機支援識別碼才會用於支援和防止濫用。你的造訪記錄絕不會附加。"
          }
        }
      }
    },
