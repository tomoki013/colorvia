            "value": "O Colorvia não exige conta, localização, fotos ou contatos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia는 계정, 위치, 사진, 연락처 정보를 요구하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia不需要账户、位置、照片或联系人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia 不需要帳號、位置、照片或聯絡資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia не требует аккаунт, геолокацию, фотографии или контакты."
          }
        }
      }
