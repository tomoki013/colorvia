    "guide.map.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch to zoom, drag to move, or use the map controls to reset the view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチで拡大し、ドラッグで移動できます。操作ボタンから初期表示へ戻せます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca para ampliar, arrastra para mover o usa los controles para restablecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez pour zoomer, faites glisser pour déplacer ou utilisez les commandes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoome mit zwei Fingern, verschiebe die Karte oder setze sie über die Steuerung zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica per ingrandire, trascina per spostare o usa i comandi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o gesto de pinça para ampliar, arraste para mover ou use os controles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락으로 확대하고 드래그해 이동하거나 지도 버튼으로 초기화하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指缩放、拖动地图，或使用地图控件重置视图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙指縮放、拖曳地圖，或使用地圖控制項目重設顯示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштабируйте жестом, перемещайте карту или используйте кнопки сброса."
          }
        }
      }
    },
