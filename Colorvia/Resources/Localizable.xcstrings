    "guide.start.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia colors the countries you have visited and keeps a simple record of your world."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorviaは訪れた国を色づけ、自分の世界をシンプルに記録します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia colorea los países que has visitado y registra tu mundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia colore les pays visités et conserve une trace simple de votre monde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia färbt besuchte Länder und hält deine Welt einfach fest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia colora i paesi visitati e registra il tuo mondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Colorvia colore os países visitados e registra o seu mundo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia는 방문한 국가를 색칠해 나의 세계를 기록합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia为你去过的国家上色，简单记录你的世界。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia 為你去過的國家上色，簡單記錄你的世界。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia раскрашивает посещённые страны и сохраняет вашу карту мира."
          }
        }
      }
    },
