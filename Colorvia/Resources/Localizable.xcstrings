    "contact.sent_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll review it and usually reply within three business days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を確認のうえ、通常3営業日以内を目安にご返信します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisaremos y normalmente responderemos en un plazo de tres días hábiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous l’examinerons et répondrons généralement sous trois jours ouvrés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir prüfen sie und antworten in der Regel innerhalb von drei Werktagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La esamineremo e di solito risponderemo entro tre giorni lavorativi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos analisá-la e normalmente responder em até três dias úteis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용을 확인한 뒤 보통 3영업일 이내에 답변드립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会查看内容，通常在三个工作日内回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會查看內容，通常在三個工作日內回覆。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы изучим его и обычно отвечаем в течение трёх рабочих дней."
          }
        }
      }
    },
    "contact.sent_body_no_reply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll read what you sent. You didn’t ask for a reply, so we won’t email you back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お送りいただいた内容を確認します。返信のご希望はいただいていないため、こちらからのご連絡はありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeremos tu mensaje. Como no pediste respuesta, no te escribiremos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous lirons votre message. Comme vous n’avez pas demandé de réponse, nous ne vous recontacterons pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir lesen Ihre Nachricht. Da Sie keine Antwort gewünscht haben, melden wir uns nicht zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggeremo il tuo messaggio. Poiché non hai chiesto una risposta, non ti ricontatteremo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos ler sua mensagem. Como você não pediu resposta, não entraremos em contato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내주신 내용을 확인하겠습니다. 답변을 요청하지 않으셨으므로 별도의 연락은 드리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会阅读您发送的内容。由于您未要求回复，我们不会另行联系。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會閱讀您傳送的內容。由於您未要求回覆，我們不會另行聯繫。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы прочитаем ваше сообщение. Ответ вы не запрашивали, поэтому писать вам не будем."
          }
        }
      }
    },
