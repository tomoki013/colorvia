    "contact.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Antwort-E-Mail, Nachricht und Informationen zur App-Umgebung werden nur beim Tippen auf Senden an den Colorvia-Support übermittelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your reply email, message, and app environment information are sent to Colorvia support only when you tap Send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu correo de respuesta, mensaje e información del entorno de la app se envían al soporte de Colorvia solo al tocar Enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre adresse e-mail de réponse, votre message et les informations d’environnement de l’app sont envoyés à l’assistance Colorvia uniquement lorsque vous touchez Envoyer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’email di risposta, il messaggio e le informazioni sull’ambiente dell’app vengono inviati all’assistenza Colorvia solo quando tocchi Invia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「送信」を押した場合にのみ、返信先メールアドレス、お問い合わせ内容、アプリの利用環境をColorviaサポートへ送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내기를 누른 경우에만 답변받을 이메일 주소, 문의 내용, 앱 이용 환경이 Colorvia 지원팀으로 전송됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu e-mail de resposta, mensagem e informações do ambiente do app são enviados ao suporte do Colorvia somente ao tocar em Enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес для ответа, сообщение и сведения о среде приложения отправляются в поддержку Colorvia только после нажатия «Отправить»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你点击“发送”后，回复电子邮件、消息和应用环境信息才会发送给 Colorvia 支持团队。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你點一下「傳送」後，回覆電子郵件、訊息和 App 環境資訊才會傳送給 Colorvia 支援團隊。"
          }
        }
      }
    },
