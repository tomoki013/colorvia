    "terms.service.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia ist ein einfaches Werkzeug zum Erfassen besuchter Länder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia is a free travel log for countries and, in supported countries, regions. It provides a world map, statistics, place search, JSON export/import, themes and map colours, sharing and in-app support. No account. Ads may appear. No paid plans or remove-ads IAP today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia se ofrece como una herramienta sencilla para registrar países visitados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia est fourni comme outil simple pour noter les pays visités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia è uno strumento semplice per registrare i paesi visitati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorviaは訪れた国と、対応国では国内地域までを記録する無料の旅の記録アプリです。世界地図、統計、地名検索、JSON書き出し・読み込み、テーマ・地図色、共有、アプリ内問い合わせを提供します。アカウントは不要です。一部画面に広告が表示される場合があります。有料プランや広告削除課金は現在ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia는 방문한 국가를 기록하는 간단한 도구입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Colorvia é uma ferramenta simples para registrar países visitados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia — простой инструмент для учёта посещённых стран."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia是一款记录到访国家的简单工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorvia 是記錄造訪國家的簡單工具。"
          }
        }
      }
    },
