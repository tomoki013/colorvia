    "privacy.storage.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your visited-country selections are stored on your device. You can delete them from Data Management."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問国の選択は端末内に保存され、データ管理から削除できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los países visitados se guardan en el dispositivo y se pueden eliminar en Gestión de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos pays visités sont stockés sur l’appareil et peuvent être supprimés dans Gestion des données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuchte Länder werden auf dem Gerät gespeichert und können in der Datenverwaltung gelöscht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I paesi visitati sono salvati sul dispositivo e possono essere eliminati da Gestione dati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os países visitados são salvos no dispositivo e podem ser excluídos em Gerenciamento de dados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문 국가 선택은 기기에 저장되며 데이터 관리에서 삭제할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到访国家选择存储在设备上，可在数据管理中删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造訪國家選擇會儲存在裝置上，可在資料管理中刪除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные страны хранятся на устройстве и удаляются в разделе управления данными."
          }
        }
      }
    },
