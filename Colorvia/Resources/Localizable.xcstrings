    "faq.percentage.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The percentage is calculated against the 195 countries defined by Colorvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorviaが定義する195か国を基準に計算しています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje se calcula sobre los 195 países definidos por Colorvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage est calculé sur les 195 pays définis par Colorvia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozentsatz basiert auf den 195 von Colorvia definierten Ländern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale è calcolata sui 195 paesi definiti da Colorvia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porcentagem é calculada com base nos 195 países definidos pelo Colorvia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorvia가 정의한 195개국을 기준으로 계산합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比以Colorvia定义的195个国家为基准计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比以 Colorvia 定義的 195 個國家為基準計算。"
          }
