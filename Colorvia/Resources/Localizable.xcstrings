    "contact.reply_required_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A question needs an answer, so we ask for an email address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご質問には返信が必要なため、メールアドレスをお伺いします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pregunta necesita respuesta, por eso pedimos un correo electrónico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une question appelle une réponse : nous vous demandons donc une adresse e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Frage braucht eine Antwort – dafür benötigen wir Ihre E-Mail-Adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una domanda richiede una risposta, perciò chiediamo un indirizzo e-mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma dúvida precisa de resposta, por isso pedimos um e-mail."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문에는 답변이 필요하므로 이메일 주소를 여쭤봅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咨询需要回复，因此需要填写电子邮件地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "諮詢需要回覆，因此需要填寫電子郵件地址。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
